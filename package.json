{
  "name": "reto-serverless",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:layer": "cd layers/lib/nodejs && npm install",
    "deploy": "npx serverless deploy --stage dev",
    "deploy:layer": "npm run build:layer && cd layers/lib && npx serverless deploy --stage dev",
    "start": "sh scripts/start.sh dev",
    "start:local": "dotenv -e .env.local -- sh scripts/start.sh local",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.1008.0",
    "@middy/core": "^6.4.5",
    "axios": "^1.16.1",
    "dotenv": "^17.3.1",
    "inversify": "^7.11.0",
    "openai": "^6.29.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@serverless/compose": "^1.3.0",
    "@serverless/typescript": "^4.30.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.21.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.52.0",
    "serverless-offline": "^13.9.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
